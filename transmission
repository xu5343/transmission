#!/bin/bash

set -euo pipefail

VERSION="4.0.5"
THEME_URL="https://github.com/jianxcao/transmission-web/releases/download/v0.1.3/transmission-web-v0.1.3.zip"

INSTALL_PREFIX="/usr/local"
CONFIG_DIR="/etc/transmission-daemon"
WEB_DIR="/usr/local/share/transmission/web"
DOWNLOAD_DIR="/data/downloads"

echo "======================================="
echo " Installing Transmission $VERSION (root mode)"
echo "======================================="

### 1️⃣ 停止旧服务
systemctl stop transmission 2>/dev/null || true
systemctl stop transmission-daemon 2>/dev/null || true
pkill transmission-daemon 2>/dev/null || true

### 2️⃣ 卸载 apt 版本
apt remove -y transmission-daemon 2>/dev/null || true

### 3️⃣ 安装依赖
apt update
apt install -y build-essential cmake pkg-config \
libevent-dev libcurl4-openssl-dev libssl-dev \
libminiupnpc-dev libnatpmp-dev zlib1g-dev \
libdeflate-dev libsystemd-dev unzip wget curl

### 4️⃣ 下载源码
cd /usr/local/src
rm -rf transmission-$VERSION*
wget -q https://github.com/transmission/transmission/releases/download/$VERSION/transmission-$VERSION.tar.xz
tar xf transmission-$VERSION.tar.xz
cd transmission-$VERSION

mkdir -p build
cd build
cmake .. -DCMAKE_INSTALL_PREFIX=$INSTALL_PREFIX -DCMAKE_BUILD_TYPE=Release
make -j$(nproc)
make install

### 5️⃣ 创建目录
install -d $CONFIG_DIR
install -d $WEB_DIR
install -d $DOWNLOAD_DIR

### 6️⃣ 安装官方 Web UI
rm -rf $WEB_DIR/*
cp -r ../web/public_html/* $WEB_DIR/

### 7️⃣ 安装主题
cd /usr/local/src
rm -rf transmission-theme
mkdir transmission-theme
cd transmission-theme

wget -q -O theme.zip $THEME_URL
unzip -q theme.zip

THEME_ROOT=$(find . -mindepth 1 -maxdepth 1 -type d | head -n1)

if [ -z "$THEME_ROOT" ]; then
    echo "❌ 主题目录识别失败"
    exit 1
fi

rm -rf $WEB_DIR/*
cp -r $THEME_ROOT/* $WEB_DIR/

### 8️⃣ 创建 systemd 服务（root 运行）
cat > /etc/systemd/system/transmission.service <<EOF
[Unit]
Description=Transmission $VERSION Daemon (root mode)
After=network.target

[Service]
Type=simple
User=root
ExecStart=$INSTALL_PREFIX/bin/transmission-daemon -f -g $CONFIG_DIR
Environment=TRANSMISSION_WEB_HOME=$WEB_DIR
Restart=on-failure
LimitNOFILE=100000

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable transmission
systemctl restart transmission

sleep 2

echo ""
echo "======================================="
echo " ✅ 安装完成"
echo "======================================="
echo ""
echo "版本:"
transmission-daemon --version
echo ""
echo "程序路径:"
echo "  $INSTALL_PREFIX/bin/transmission-daemon"
echo ""
echo "配置目录:"
echo "  $CONFIG_DIR"
echo ""
echo "下载目录:"
echo "  $DOWNLOAD_DIR"
echo ""
echo "Web UI 路径:"
echo "  $WEB_DIR"
echo ""
echo "访问地址:"
echo "  http://服务器IP:9091"
echo ""
echo "服务状态:"
systemctl status transmission --no-pager
echo "======================================="
